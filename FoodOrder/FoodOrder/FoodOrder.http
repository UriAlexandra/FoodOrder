@HostAddress = https://localhost:7060

### 1. Get Available Menu
GET {{HostAddress}}/api/dishes?onlyAvailable=true

### 2. Place Order (User)
# @name placeOrder
POST {{HostAddress}}/api/orders
Content-Type: application/json

{
  "deliveryAddress": "1055 Budapest, Kossuth Lajos tér 1-3.",
  "note": "Kapucsengő 42",
  "customerName": "Kiss Anna",
  "customerEmail": "anna@example.com",
  "items": [
    { "dishId": 1, "quantity": 2 },
    { "dishId": 3, "quantity": 1 }
  ]
}

### (Extract OrderId from the response to a variable)
@OrderId = {{placeOrder.response.body.orderId}}

### 3. Track Order (Verify Version = 1, Status = Placed)
GET {{HostAddress}}/api/orders/{{OrderId}}

### 4. Staff Accepts Order (Version 1 -> 2)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "Accepted",
  "expectedVersion": 1
}

### 5. Staff Assigns Courier (CourierId: 1, Version 2 -> 3)
POST {{HostAddress}}/api/orders/{{OrderId}}/courier
Content-Type: application/json

{
  "courierId": 1,
  "expectedVersion": 2
}

### 6. Order Preparing (Version 3 -> 4)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "Preparing",
  "expectedVersion": 3
}

### 7. Ready for Pickup (Version 4 -> 5)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "ReadyForPickup",
  "expectedVersion": 4
}

### 8. Out for Delivery (Version 5 -> 6)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "OutForDelivery",
  "expectedVersion": 5
}

### 9. Delivered (Version 6 -> 7)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "Delivered",
  "expectedVersion": 6
}

### 10. ERROR TEST: Try to transition Delivered -> Preparing (EXPECT 409)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "Preparing",
  "expectedVersion": 7
}

### 11. ERROR TEST: Concurrency Conflict (EXPECT 409)
# Send Cancelled with outdated ExpectedVersion (1 instead of 7)
POST {{HostAddress}}/api/orders/{{OrderId}}/status
Content-Type: application/json

{
  "newStatus": "Cancelled",
  "expectedVersion": 1
}