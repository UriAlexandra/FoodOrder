<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <h2 class="mb-3">Hozzáférés megtagadva</h2>
                    <div class="alert alert-danger" role="alert">Nincs jogosultságod ehhez az oldalhoz.</div>
                    <a href="" class="btn btn-outline-primary">Vissza a főoldalra</a>
                }
            </NotAuthorized>
            <Authorizing>
                <LoadingIndicator Text="Bejelentkezés ellenőrzése..." />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
