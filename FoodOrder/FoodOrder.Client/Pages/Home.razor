@page "/"
@inject FoodOrderStore Store
@implements IDisposable

<PageTitle>Étlap</PageTitle>

<h2 class="mb-4">Aktuális Kínálatunk</h2>

@if (Store.CurrentRole != UserRole.Customer)
{
    <div class="alert alert-warning">
        Jelenleg éttermi dolgozóként vagy bejelentkezve. A rendeléshez válts vásárló szerepkörre!
    </div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var dish in Store.Dishes.Where(d => d.IsAvailable))
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-secondary mb-2">@dish.Category</span>
                        <span class="fw-bold text-success fs-5">@HufFormatter.Format(dish.Price)</span>
                    </div>
                    <h5 class="card-title fw-bold">@dish.Name</h5>
                    <p class="card-text text-muted">@dish.Description</p>

                    <div class="mt-auto pt-3 border-top">
                        @if (Store.CurrentRole == UserRole.Customer)
                        {
                            <div class="input-group">
                                <input type="number" class="form-control" min="1" max="20" @bind="Quantities[dish.Id]" />
                                <button class="btn btn-primary" @onclick="() => AddToCart(dish)">
                                    Kosárba
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Store.Dishes.Any(d => d.IsAvailable))
{
    <p class="text-muted mt-3">Jelenleg nincs elérhető étel az étlapon.</p>
}

@code {
    private Dictionary<Guid, int> Quantities = new();

    protected override void OnInitialized()
    {
        Store.OnChange += StateHasChanged;
        InitializeQuantities();
    }

    private void InitializeQuantities()
    {
        foreach (var dish in Store.Dishes)
        {
            if (!Quantities.ContainsKey(dish.Id))
                Quantities[dish.Id] = 1;
        }
    }

    private async Task AddToCart(DishDto dish)
    {
        if (Quantities.TryGetValue(dish.Id, out int qty) && qty > 0)
        {
            await Store.AddToCartAsync(dish, qty);
            Quantities[dish.Id] = 1; // Reset
        }
    }

    public void Dispose()
    {
        Store.OnChange -= StateHasChanged;
    }
}