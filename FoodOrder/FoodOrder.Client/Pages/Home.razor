@page "/"
@inject IMenuService MenuService
@inject ICartService CartService
@inject NavigationManager Navigation

<PageTitle>Étlap</PageTitle>

<h2 class="mb-4">Étlap</h2>

@if (_isStaff)
{
    <div class="alert alert-info">Éttermi dolgozóként nézed az étlapot. Az ételeket az <a href="etterem/etlap">Étlap kezelése</a> oldalon módosíthatod.</div>
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        Rendeléshez <a href="bejelentkezes">jelentkezz be</a>, vagy <a href="regisztracio">regisztrálj</a>.
    </div>
}

@if (_addedMessage is not null)
{
    <div class="alert alert-success py-2" role="status">@_addedMessage</div>
}

@if (_loading)
{
    <LoadingIndicator Text="Étlap betöltése..." />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" OnRetry="LoadAsync" />
}
else if (!AvailableDishes.Any())
{
    <p class="text-muted">Jelenleg nincs rendelhető étel.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var dish in AvailableDishes)
        {
            <div class="col">
                <DishCard Dish="dish"
                          ShowCartActions="@(!_isStaff)"
                          OnAddToCart="HandleAddToCart" />
            </div>
        }
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _addedMessage;
    private bool _isAuthenticated;
    private bool _isStaff;

    private IEnumerable<DishDto> AvailableDishes => MenuService.Dishes.Where(d => d.IsAvailable);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Be- vagy kijelentkezéskor az új állapot paraméterként érkezik.
    protected override async Task OnParametersSetAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        _isAuthenticated = user?.Identity?.IsAuthenticated == true;
        _isStaff = user?.IsInRole(AppRoles.Staff) == true;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            await MenuService.LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleAddToCart((DishDto dish, int quantity) payload)
    {
        // Bejelentkezés nélkül nincs kosár: a Kosárba gomb a bejelentkezésre visz, utána ide térünk vissza.
        if (!_isAuthenticated)
        {
            Navigation.NavigateTo("bejelentkezes?returnUrl=%2F");
            return;
        }

        await CartService.AddToCartAsync(payload.dish, payload.quantity);
        _addedMessage = $"{payload.quantity} × {payload.dish.Name} a kosárba került.";
    }
}
