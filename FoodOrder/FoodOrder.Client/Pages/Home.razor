@page "/"
@inject IMenuService MenuService
@inject ICartService CartService
@inject ISessionService SessionService
@implements IDisposable

<PageTitle>Étlap</PageTitle>

<h2 class="mb-4">Aktuális Kínálatunk</h2>

@if (SessionService.CurrentRole != UserRole.Customer)
{
    <div class="alert alert-warning">
        Jelenleg éttermi dolgozóként vagy bejelentkezve. A rendeléshez válts vásárló szerepkörre!
    </div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var dish in MenuService.Dishes.Where(d => d.IsAvailable))
    {
        <div class="col">
            <DishCard Dish="dish"
                      ShowCartActions="@(SessionService.CurrentRole == UserRole.Customer)"
                      OnAddToCart="HandleAddToCart" />
        </div>
    }
</div>

@if (!MenuService.Dishes.Any(d => d.IsAvailable))
{
    <p class="text-muted mt-3">Jelenleg nincs elérhető étel az étlapon.</p>
}

@code {
    protected override void OnInitialized()
    {
        MenuService.OnChange += StateHasChanged;
        SessionService.OnChange += StateHasChanged;
    }

    private async Task HandleAddToCart((DishDto dish, int quantity) payload)
    {
        await CartService.AddToCartAsync(payload.dish, payload.quantity);
    }

    public void Dispose()
    {
        MenuService.OnChange -= StateHasChanged;
        SessionService.OnChange -= StateHasChanged;
    }
}