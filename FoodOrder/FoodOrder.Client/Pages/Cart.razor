@page "/kosar"
@using System.ComponentModel.DataAnnotations
@inject ICartService CartService
@inject IMenuService MenuService
@inject IOrderService OrderService
@inject ISessionService SessionService
@implements IDisposable

<PageTitle>Kosár</PageTitle>

<h2 class="mb-4">Kosár</h2>

@if (SessionService.CurrentRole != UserRole.Customer)
{
    <div class="alert alert-warning">A kosár csak vásárlóként érhető el. Válts vásárló szerepkörre a felső sávban.</div>
}
else if (_placedOrderId is not null)
{
    <div class="alert alert-success p-4 shadow-sm text-center" role="status">
        <h4 class="alert-heading">Köszönjük a rendelést!</h4>
        <p class="mb-0">A rendelés azonosítója: <strong>#@_placedOrderId</strong></p>
        <hr />
        <a href="@($"rendeleseim/{_placedOrderId}")" class="btn btn-success">Rendelés követése</a>
    </div>
}
else if (!CartService.Items.Any())
{
    <div class="alert alert-info">A kosarad jelenleg üres.</div>
    <a href="" class="btn btn-outline-primary">Tovább az étlapra</a>
}
else
{
    <ErrorAlert Message="@_error" Details="@_errorDetails" />

    @if (HasUnavailableItems)
    {
        <div class="alert alert-warning" role="alert">
            A megjelölt tételek jelenleg nem rendelhetők. Töröld őket a kosárból a rendelés leadása előtt.
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="table-responsive position-relative shadow-sm bg-white rounded p-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Étel</th>
                            <th scope="col" style="width: 110px;">Mennyiség</th>
                            <th scope="col" class="text-end">Egységár</th>
                            <th scope="col" class="text-end">Összesen</th>
                            <th scope="col"><span class="visually-hidden">Műveletek</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in CartService.Items)
                        {
                            <CartLine Item="item"
                                      UnitPrice="@PriceOf(item)"
                                      IsUnavailable="@IsUnavailable(item)"
                                      OnUpdateQuantity="HandleUpdateQuantity"
                                      OnRemove="HandleRemoveItem" />
                        }
                    </tbody>
                    <tfoot class="border-top">
                        <tr>
                            <td colspan="3" class="text-end fw-bold fs-5">Végösszeg:</td>
                            <td class="text-end fw-bold fs-5 text-success text-nowrap">@HufFormatter.Format(Total)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold">Szállítási adatok</div>
                <div class="card-body">
                    <EditForm Model="_checkout" OnValidSubmit="PlaceOrderAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="address">Szállítási cím</label>
                            <InputText id="address" class="form-control" @bind-Value="_checkout.Address"
                                       placeholder="Pl. 1011 Budapest, Fő utca 1." />
                            <ValidationMessage For="@(() => _checkout.Address)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="note">Megjegyzés (nem kötelező)</label>
                            <InputTextArea id="note" class="form-control" @bind-Value="_checkout.Note" rows="2"
                                           placeholder="Kapucsengő, emelet..." />
                            <ValidationMessage For="@(() => _checkout.Note)" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2"
                                disabled="@(_submitting || HasUnavailableItems)">
                            @(_submitting ? "Küldés..." : "Rendelés leadása")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CheckoutModel _checkout = new();
    private int? _placedOrderId;
    private bool _submitting;
    private string? _error;
    private IReadOnlyList<string> _errorDetails = [];

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        SessionService.OnChange += StateHasChanged;

        // A kosárban tárolt ár és elérhetőség elavulhatott: frissítjük a szerver szerinti étlappal.
        await RefreshMenuAsync();
    }

    private async Task RefreshMenuAsync()
    {
        try
        {
            await MenuService.LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private DishDto? CurrentDish(CartItemDto item) =>
        MenuService.Dishes.FirstOrDefault(d => d.Id == item.Dish.Id);

    // Ha az étlap betöltődött, és az étel nincs rajta vagy nem rendelhető, a tételt megjelöljük.
    private bool IsUnavailable(CartItemDto item) =>
        MenuService.Dishes.Count > 0 && CurrentDish(item) is not { IsAvailable: true };

    private decimal PriceOf(CartItemDto item) => CurrentDish(item)?.Price ?? item.Dish.Price;

    private bool HasUnavailableItems => CartService.Items.Any(IsUnavailable);

    private decimal Total => CartService.Items.Sum(i => PriceOf(i) * i.Quantity);

    private Task HandleUpdateQuantity((int dishId, int newQuantity) payload) =>
        CartService.UpdateCartItemAsync(payload.dishId, payload.newQuantity);

    private Task HandleRemoveItem(int dishId) => CartService.RemoveFromCartAsync(dishId);

    private async Task PlaceOrderAsync()
    {
        _submitting = true;
        _error = null;
        _errorDetails = [];
        try
        {
            _placedOrderId = await OrderService.PlaceOrderAsync(CartService.Items, _checkout.Address, _checkout.Note);
            await CartService.ClearCartAsync();
            _checkout = new CheckoutModel();
        }
        catch (ApiException ex)
        {
            // A kosár megmarad; ha közben egy étel elérhetetlenné vált, az étlap frissítése megjelöli.
            _error = ex.Message;
            _errorDetails = ex.FieldMessages;
            await RefreshMenuAsync();
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
        SessionService.OnChange -= StateHasChanged;
    }

    public class CheckoutModel
    {
        [Required(ErrorMessage = "A szállítási cím megadása kötelező.")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "A cím legalább 5, legfeljebb 200 karakter lehet.")]
        public string Address { get; set; } = string.Empty;

        [MaxLength(300, ErrorMessage = "A megjegyzés legfeljebb 300 karakter lehet.")]
        public string? Note { get; set; }
    }
}
