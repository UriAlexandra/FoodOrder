@page "/etterem/futarok"
@attribute [Authorize(Roles = AppRoles.Staff)]
@inject ICourierService CourierService

<PageTitle>Futárok</PageTitle>

<h2 class="mb-4">Futárok</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white fw-bold">Új futár felvétele</div>
    <div class="card-body">
        <ErrorAlert Message="@_formError" Details="@_formErrorDetails" />
        @if (_savedMessage is not null)
        {
            <div class="alert alert-success py-2" role="status">@_savedMessage</div>
        }

        <EditForm Model="_newCourier" OnValidSubmit="AddCourierAsync">
            <DataAnnotationsValidator />
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="courier-name">Név</label>
                    <InputText id="courier-name" class="form-control" @bind-Value="_newCourier.Name" />
                    <ValidationMessage For="@(() => _newCourier.Name)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="courier-phone">Telefonszám</label>
                    <InputText id="courier-phone" class="form-control" @bind-Value="_newCourier.Phone"
                               placeholder="+36 30 123 4567" />
                    <ValidationMessage For="@(() => _newCourier.Phone)" class="text-danger small" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success w-100 fw-bold" disabled="@_saving">
                        @(_saving ? "Mentés..." : "Felvétel")
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

<ErrorAlert Message="@_listWarning" Warning="true" />

@if (_loading)
{
    <LoadingIndicator Text="Futárok betöltése..." />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" OnRetry="LoadAsync" />
}
else if (_couriers.Count == 0)
{
    <p class="text-muted">Még nincs futár felvéve.</p>
}
else
{
    <div class="table-responsive position-relative shadow-sm">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Név</th>
                    <th scope="col">Telefonszám</th>
                    <th scope="col">Állapot</th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Műveletek</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var courier in _couriers)
                {
                    var busy = _busyCouriers.Contains(courier.Id);
                    <tr>
                        <td class="fw-semibold">@courier.Name</td>
                        <td class="text-nowrap">@HuPhoneFormatter.Format(courier.Phone)</td>
                        <td>
                            <span class="badge @(courier.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(courier.IsActive ? "Aktív" : "Inaktív")
                            </span>
                        </td>
                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-sm @(courier.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                    disabled="@busy"
                                    @onclick="() => ToggleActiveAsync(courier)">
                                @(courier.IsActive ? "Inaktiválás" : "Aktiválás")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CourierDto> _couriers = new();
    private CreateCourierRequest _newCourier = new();
    private readonly HashSet<int> _busyCouriers = new();
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _listWarning;
    private string? _formError;
    private IReadOnlyList<string> _formErrorDetails = [];
    private string? _savedMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _couriers = await CourierService.GetCouriersAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddCourierAsync()
    {
        _saving = true;
        _formError = null;
        _formErrorDetails = [];
        _savedMessage = null;
        try
        {
            var created = await CourierService.AddCourierAsync(_newCourier);
            _couriers.Add(created);
            _savedMessage = $"{created.Name} felvéve.";
            _newCourier = new CreateCourierRequest();
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
            _formErrorDetails = ex.FieldMessages;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActiveAsync(CourierDto courier)
    {
        _busyCouriers.Add(courier.Id);
        _listWarning = null;
        try
        {
            var updated = await CourierService.SetActiveAsync(courier.Id, !courier.IsActive);
            var index = _couriers.FindIndex(c => c.Id == updated.Id);
            if (index >= 0) _couriers[index] = updated;
        }
        catch (ApiException ex)
        {
            _listWarning = ex.Message;
        }
        finally
        {
            _busyCouriers.Remove(courier.Id);
        }
    }
}
