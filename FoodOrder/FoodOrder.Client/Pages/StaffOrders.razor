@page "/etterem/rendelesek"
@inject IOrderService OrderService
@inject ISessionService SessionService
@implements IDisposable

<PageTitle>Beérkezett Rendelések</PageTitle>

<h2 class="mb-4">Beérkezett Rendelések (Éttermi nézet)</h2>

@if (SessionService.CurrentRole != UserRole.Staff)
{
    <div class="alert alert-danger">Nincs jogosultságod ehhez az oldalhoz!</div>
}
else if (!OrderService.Orders.Any())
{
    <p class="text-muted">Nincsenek beérkezett rendelések.</p>
}
else
{
    <div class="row row-cols-1 g-4">
        @foreach (var order in OrderService.Orders)
        {
            <div class="col">
                <OrderCard Order="order" IsStaffView="true" />
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        OrderService.OnChange += StateHasChanged;
        SessionService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        OrderService.OnChange -= StateHasChanged;
        SessionService.OnChange -= StateHasChanged;
    }
}