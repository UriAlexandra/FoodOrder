@page "/rendeleseim"
@attribute [Authorize(Roles = AppRoles.Customer)]
@inject IOrderService OrderService

<PageTitle>Rendeléseim</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="mb-0">Rendeléseim</h2>
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">Frissítés</button>
</div>

@if (_loading && _orders.Count == 0)
{
    <LoadingIndicator Text="Rendelések betöltése..." />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" OnRetry="LoadAsync" />
}
else if (_orders.Count == 0)
{
    <p class="text-muted">Még nem adtál le rendelést.</p>
    <a href="" class="btn btn-outline-primary">Tovább az étlapra</a>
}
else
{
    <div class="row row-cols-1 g-4">
        @foreach (var order in _orders)
        {
            <div class="col">
                <OrderCard Order="order">
                    <a class="btn btn-sm btn-outline-primary" href="@($"rendeleseim/{order.Id}")">Követés</a>
                </OrderCard>
            </div>
        }
    </div>
}

@code {
    private List<OrderDto> _orders = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _orders = await OrderService.GetOrdersAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
