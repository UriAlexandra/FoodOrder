@page "/rendeleseim"
@attribute [Authorize(Roles = AppRoles.Customer)]
@inject IOrderService OrderService
@inject OrderUpdatesClient Updates
@implements IDisposable

<PageTitle>Rendeléseim</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="mb-0">Rendeléseim</h2>
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">Frissítés</button>
</div>

@if (_loading && _orders.Count == 0)
{
    <LoadingIndicator Text="Rendelések betöltése..." />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" OnRetry="LoadAsync" />
}
else if (_orders.Count == 0)
{
    <p class="text-muted">Még nem adtál le rendelést.</p>
    <a href="" class="btn btn-outline-primary">Tovább az étlapra</a>
}
else
{
    <div class="row row-cols-1 g-4">
        @foreach (var order in _orders)
        {
            <div class="col">
                <OrderCard Order="order">
                    <a class="btn btn-sm btn-outline-primary" href="@($"rendeleseim/{order.Id}")">Követés</a>
                </OrderCard>
            </div>
        }
    </div>
}

@code {
    private List<OrderDto> _orders = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Updates.OrderChanged += OnOrderChangedAsync;
        Updates.Reconnected += OnReconnectedAsync;
        await LoadAsync();
    }

    // Valós idejű frissítés: csak az érintett rendelést kérjük le újra.
    private Task OnOrderChangedAsync(OrderChangedEvent change) => InvokeAsync(async () =>
    {
        var index = _orders.FindIndex(o => o.Id == change.OrderId);
        if (index >= 0 && change.Version <= _orders[index].Version)
            return;

        try
        {
            var order = await OrderService.GetOrderAsync(change.OrderId);
            index = _orders.FindIndex(o => o.Id == order.Id);
            if (index >= 0)
                _orders[index] = order;
            else
                _orders.Insert(0, order); // pl. egy másik böngészőlapon leadott rendelés
            StateHasChanged();
        }
        catch (ApiException)
        {
            // A lista a következő újratöltéskor pótolja.
        }
    });

    private Task OnReconnectedAsync() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _orders = await OrderService.GetOrdersAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        Updates.OrderChanged -= OnOrderChangedAsync;
        Updates.Reconnected -= OnReconnectedAsync;
    }
}
