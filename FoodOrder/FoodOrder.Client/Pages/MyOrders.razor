@page "/rendeleseim"
@inject IOrderService OrderService
@inject ISessionService SessionService
@implements IDisposable

<PageTitle>Rendeléseim</PageTitle>

<h2 class="mb-4">Saját Rendeléseim</h2>

@if (SessionService.CurrentRole != UserRole.Customer)
{
    <div class="alert alert-warning">Vásárlóként jelentkezz be a saját rendeléseid megtekintéséhez!</div>
}

@{
    var myOrders = OrderService.Orders.Where(o => o.CustomerName == "Kiss Anna").ToList();
}

@if (!myOrders.Any())
{
    <p class="text-muted">Még nem adtál le rendelést.</p>
}
else
{
    <div class="row row-cols-1 g-4">
        @foreach (var order in myOrders)
        {
            <div class="col">
                <OrderCard Order="order" IsStaffView="false" />
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        OrderService.OnChange += StateHasChanged;
        SessionService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        OrderService.OnChange -= StateHasChanged;
        SessionService.OnChange -= StateHasChanged;
    }
}