<tr class="align-middle">
    <td>
        <strong>@Item.Dish.Name</strong><br />
        <small class="text-muted">@DishCategories.Label(Item.Dish.Category)</small>
    </td>
    <td>
        <input type="number" class="form-control form-control-sm" min="1"
               value="@Item.Quantity"
               @onchange="QuantityChanged" />
    </td>
    <td class="text-end">@HufFormatter.Format(Item.Dish.Price)</td>
    <td class="text-end fw-bold">@HufFormatter.Format(Item.Dish.Price * Item.Quantity)</td>
    <td class="text-end">
        <button class="btn btn-sm btn-outline-danger" @onclick="RemoveClicked">X</button>
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public CartItemDto Item { get; set; } = default!;
    [Parameter] public EventCallback<(int dishId, int newQuantity)> OnUpdateQuantity { get; set; }
    [Parameter] public EventCallback<int> OnRemove { get; set; }

    private async Task QuantityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int q))
        {
            await OnUpdateQuantity.InvokeAsync((Item.Dish.Id, q));
        }
    }

    private async Task RemoveClicked()
    {
        await OnRemove.InvokeAsync(Item.Dish.Id);
    }
}