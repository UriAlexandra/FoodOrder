<div class="card shadow-sm h-100">
    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-bold">Rendelés #@Order.Id</span>
        <StatusBadge Status="@Order.Status" Text="@Order.StatusDisplayName" />
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                @if (IsStaffView)
                {
                    <p class="mb-1"><strong>Vásárló:</strong> @Order.CustomerName</p>
                }
                <p class="mb-1 small"><strong>Cím:</strong> @Order.DeliveryAddress</p>
                @if (!string.IsNullOrWhiteSpace(Order.Note))
                {
                    <p class="mb-1 small"><strong>Megjegyzés:</strong> @Order.Note</p>
                }
                <p class="mb-1 small"><strong>Leadva:</strong> @HuDateFormatter.Format(Order.PlacedAt)</p>
                @if (Order.CourierName is not null)
                {
                    <p class="mb-1 small"><strong>Futár:</strong> @Order.CourierName (@HuPhoneFormatter.Format(Order.CourierPhone))</p>
                }
            </div>
            <div class="col-md-7">
                <table class="table table-sm table-borderless mb-0">
                    <caption class="visually-hidden">A rendelés tételei</caption>
                    <tbody>
                        @foreach (var item in Order.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-nowrap" style="width: 3rem;">@item.Quantity ×</td>
                                <td>@item.DishName</td>
                                <td class="text-end small text-nowrap">@HufFormatter.Format(item.Price * item.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">@ChildContent</div>
            <span class="fs-5">Végösszeg: <strong class="text-success">@HufFormatter.Format(Order.Total)</strong></span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public OrderDto Order { get; set; } = default!;
    [Parameter] public bool IsStaffView { get; set; }

    /// <summary>A kártya aljára kerülő műveletek (pl. állapotváltó gombok, követés link).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
