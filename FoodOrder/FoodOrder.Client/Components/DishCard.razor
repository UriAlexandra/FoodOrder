<div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between">
            <span class="badge bg-secondary mb-2">@DishCategories.Label(Dish.Category)</span>
            <span class="fw-bold text-success fs-5">@HufFormatter.Format(Dish.Price)</span>
        </div>
        <h5 class="card-title fw-bold">@Dish.Name</h5>
        <p class="card-text text-muted">@Dish.Description</p>

        @if (ShowCartActions)
        {
            <div class="mt-auto pt-3 border-top">
                <div class="input-group">
                    <input type="number" class="form-control" min="1" max="20" @bind="Quantity" />
                    <button class="btn btn-primary" @onclick="AddToCartClicked">
                        Kosárba
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DishDto Dish { get; set; } = default!;
    [Parameter] public bool ShowCartActions { get; set; }
    [Parameter] public EventCallback<(DishDto dish, int quantity)> OnAddToCart { get; set; }

    private int Quantity = 1;

    private async Task AddToCartClicked()
    {
        if (Quantity > 0)
        {
            await OnAddToCart.InvokeAsync((Dish, Quantity));
            Quantity = 1; // Reset after adding
        }
    }
}