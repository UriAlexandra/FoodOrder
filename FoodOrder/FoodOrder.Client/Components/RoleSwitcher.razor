@inject ISessionService SessionService
@implements IDisposable

<div class="d-flex align-items-center">
    <label class="me-2 fw-semibold text-muted">Szerepkör:</label>
    <select class="form-select form-select-sm w-auto" value="@SessionService.CurrentRole.ToString()" @onchange="OnRoleChanged">
        <option value="Customer">Kiss Anna – Vásárló</option>
        <option value="Staff">Nagy Péter – Éttermi dolgozó</option>
    </select>
</div>

@code {
    protected override void OnInitialized()
    {
        SessionService.OnChange += StateHasChanged;
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UserRole>(e.Value?.ToString(), out var role))
        {
            await SessionService.SetRoleAsync(role);
        }
    }

    public void Dispose()
    {
        SessionService.OnChange -= StateHasChanged;
    }
}