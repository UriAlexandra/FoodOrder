@inject ISessionService SessionService
@implements IDisposable

<div class="d-flex align-items-center gap-2">
    <label class="fw-semibold text-muted mb-0 d-none d-md-inline" for="role-switcher">Szerepkör:</label>
    <select id="role-switcher" class="form-select form-select-sm w-auto" aria-label="Szerepkör"
            value="@SessionService.CurrentRole.ToString()" @onchange="OnRoleChanged">
        <option value="Customer">Kiss Anna – Vásárló</option>
        <option value="Staff">Nagy Péter – Éttermi dolgozó</option>
    </select>
</div>

@code {
    protected override void OnInitialized()
    {
        SessionService.OnChange += StateHasChanged;
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UserRole>(e.Value?.ToString(), out var role))
        {
            await SessionService.SetRoleAsync(role);
        }
    }

    public void Dispose()
    {
        SessionService.OnChange -= StateHasChanged;
    }
}