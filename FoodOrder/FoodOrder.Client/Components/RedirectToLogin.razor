@inject NavigationManager Navigation

@* Bejelentkezetlen felhasználó védett oldalon: a bejelentkezés után ide térünk vissza. *@
<LoadingIndicator Text="Átirányítás a bejelentkezéshez..." />

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"bejelentkezes?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
