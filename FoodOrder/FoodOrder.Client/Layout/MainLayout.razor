@inherits LayoutComponentBase
@inject FoodOrderStore Store
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-light border-bottom">
            <h5 class="mb-0 text-primary fw-bold">FoodOrder</h5>

            @if (Store.IsInitialized)
            {
                <div class="d-flex align-items-center">
                    <label class="me-2 fw-semibold text-muted">Szerepkör:</label>
                    <select class="form-select form-select-sm w-auto" value="@Store.CurrentRole.ToString()" @onchange="OnRoleChanged">
                        <option value="Customer">Kiss Anna – Vásárló</option>
                        <option value="Staff">Nagy Péter – Éttermi dolgozó</option>
                    </select>
                </div>
            }
        </div>

        <article class="content px-4 py-4">
            @if (!Store.IsInitialized)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3">Betöltés...</p>
                </div>
            }
            else
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Store.InitializeAsync();
            Store.OnChange += StateHasChanged;
            StateHasChanged();
        }
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UserRole>(e.Value?.ToString(), out var role))
        {
            await Store.SetRoleAsync(role);
        }
    }

    public void Dispose()
    {
        Store.OnChange -= StateHasChanged;
    }
}