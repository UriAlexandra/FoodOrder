@inherits LayoutComponentBase
@inject ISessionService SessionService
@inject IMenuService MenuService
@inject ICartService CartService
@inject IOrderService OrderService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-light border-bottom">
            <h5 class="mb-0 text-primary fw-bold">FoodOrder</h5>

            @if (_isInitialized)
            {
                <RoleSwitcher />
            }
        </div>

        <article class="content px-4 py-4">
            @if (!_isInitialized)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3">Betöltés...</p>
                </div>
            }
            else
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    private bool _isInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionService.InitializeAsync();
            await MenuService.InitializeAsync();
            await CartService.InitializeAsync();
            await OrderService.InitializeAsync();

            _isInitialized = true;
            StateHasChanged();
        }
    }
}