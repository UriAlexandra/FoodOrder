@inherits LayoutComponentBase
@inject ISessionService SessionService
@inject ICartService CartService
@inject IKeyValueStorage Storage

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center gap-2 bg-light border-bottom">
            <h5 class="mb-0 text-primary fw-bold d-none d-sm-block">FoodOrder</h5>

            @if (_isInitialized)
            {
                <RoleSwitcher />
            }
        </div>

        <div class="alert alert-warning rounded-0 border-0 border-bottom mb-0 py-2 px-4 small" role="note">
            Fejlesztői változat – a szerepkörváltó még nem bejelentkezés
        </div>

        <article class="content px-4 py-4">
            @if (!_isInitialized)
            {
                <LoadingIndicator />
            }
            else
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    private bool _isInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Az étlap és a rendelések már a szerveren vannak: a régi localStorage-kulcsokat töröljük.
        await Storage.RemoveItemAsync(StorageKeys.LegacyDishes);
        await Storage.RemoveItemAsync(StorageKeys.LegacyOrders);

        await SessionService.InitializeAsync();
        await CartService.InitializeAsync();

        _isInitialized = true;
        StateHasChanged();
    }
}
