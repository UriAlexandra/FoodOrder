@inherits LayoutComponentBase
@inject ICartService CartService
@inject IKeyValueStorage Storage
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject OrderUpdatesClient Updates

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center gap-2 bg-light border-bottom">
            <span class="fs-5 mb-0 text-primary fw-bold d-none d-sm-inline">FoodOrder</span>

            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2 ms-auto user-box">
                        <span class="text-truncate fw-semibold" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
                        <span class="badge text-bg-secondary d-none d-md-inline">
                            @(context.User.IsInRole(AppRoles.Staff) ? "Éttermi dolgozó" : "Vásárló")
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="LogoutAsync">Kijelentkezés</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <a class="btn btn-sm btn-primary ms-0" href="bejelentkezes">Bejelentkezés</a>
                        <a class="btn btn-sm btn-outline-primary ms-0" href="regisztracio">Regisztráció</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <RealtimeStatus />

        <article class="content px-4 py-4">
            @if (!_isInitialized)
            {
                <LoadingIndicator />
            }
            else
            {
                @* Egy oldal váratlan hibája nem viszi magával az egész alkalmazást: magyar hibaüzenet, újrapróbálás. *@
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <h2 class="mb-3">Váratlan hiba történt</h2>
                        <div class="alert alert-danger" role="alert">
                            Az oldal megjelenítése közben hiba lépett fel. Próbáld újra, vagy térj vissza az étlapra.
                        </div>
                        <button type="button" class="btn btn-primary me-2" @onclick="RecoverFromError">Újrapróbálás</button>
                        <a href="" class="btn btn-outline-secondary">Vissza az étlapra</a>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </article>
    </main>
</div>

@* Ha az alkalmazás teljesen leáll (pl. megszakadt a betöltés), a Blazor ezt a sávot jeleníti meg. *@
<div id="blazor-error-ui" data-nosnippet role="alert">
    Váratlan hiba történt. <a href="." class="reload">Oldal újratöltése</a>
    <button type="button" class="dismiss btn-close" aria-label="Bezárás"></button>
</div>

<ToastHost />

@* A vásárló bármelyik oldalon felugró értesítést kap, ha a rendelése állapota megváltozik. *@
<AuthorizeView Roles="@AppRoles.Customer" Context="customer">
    <Authorized>
        <CustomerOrderNotifier />
    </Authorized>
</AuthorizeView>

@code {
    private bool _isInitialized;
    private ErrorBoundary? _errorBoundary;

    // Másik oldalra lépve a korábbi hiba már nem érvényes.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void RecoverFromError() => _errorBoundary?.Recover();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Korábbi hetek böngészőben tárolt adatai (étlap, rendelések, demó szerepkör, közös kosár) már nem kellenek.
        foreach (var key in StorageKeys.Legacy)
            await Storage.RemoveItemAsync(key);

        await CartService.InitializeAsync();

        // Valós idejű rendelésértesítések: bejelentkezett felhasználónál most kapcsolódik, később be- és kijelentkezéskor vált.
        await Updates.InitializeAsync();

        _isInitialized = true;
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("");
    }
}
