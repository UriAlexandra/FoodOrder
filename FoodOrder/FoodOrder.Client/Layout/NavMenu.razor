@inject ICartService CartService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FoodOrder</a>
    </div>
</div>

<input type="checkbox" title="Navigációs menü" aria-label="Navigációs menü megnyitása" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column" aria-label="Fő navigáció">
        <AuthorizeView Roles="@AppRoles.Staff" Context="staff">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="etterem/rendelesek">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Beérkezett rendelések
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="etterem/etlap">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Étlap kezelése
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="etterem/futarok">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Futárok
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Étlap
                    </NavLink>
                </div>
                <AuthorizeView Roles="@AppRoles.Customer" Context="customer">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="kosar">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Kosár
                                @if (CartService.Items.Any())
                                {
                                    <span class="badge bg-danger ms-2">@CartService.Items.Sum(c => c.Quantity)</span>
                                }
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="rendeleseim">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Rendeléseim
                            </NavLink>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="bejelentkezes">
                                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Bejelentkezés
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="regisztracio">
                                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Regisztráció
                            </NavLink>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
